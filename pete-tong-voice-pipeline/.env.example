# Copy to .env and fill in your values
# .env is gitignored — never commit real tokens

# Required: HuggingFace token for pyannote speaker diarisation models
# Get it from: https://huggingface.co/settings/tokens
# Accept model terms at:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=hf_your_token_here

# Optional overrides (all have sensible defaults)
# PT_OUTPUT_DIR=./pete_tong_samples
# PT_MIN_CLIP_S=5
# PT_MAX_CLIP_S=120
# PT_TARGET_CLIP_S=45
# PT_MIN_SNR_DB=12
# PT_WHISPER_MODEL=medium
# PT_DEMUCS_MODEL=htdemucs
