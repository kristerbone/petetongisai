{
	"name": "site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"sst": "./scripts/with-aws.sh sst",
		"deploy": "./scripts/with-aws.sh sst deploy --stage production",
		"deploy:staging": "./scripts/with-aws.sh sst deploy --stage staging"
	},
	"devDependencies": {
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"sst": "^4.17.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"svelte-kit-sst": "^2.43.5",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	}
}
